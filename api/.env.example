NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pulsewatch:pulsewatch_dev@localhost:5432/pulsewatch?schema=public
JWT_SECRET=change-this-in-production-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
ENABLE_SCHEDULER=true
CHECK_WORKER_BATCH_SIZE=10

# Optional SMTP notifications. Leave SMTP_HOST empty to disable email delivery.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# Use a Gmail app password; never your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PulseWatch <noreply@example.com>
